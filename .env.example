# MongoDB Atlas connection string; keep real credentials in your shell/hosting dashboard.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/jetsetgo?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
PAYMENT_MODE=DEMO
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend build-time variable (set in Vercel, not in the backend service).
VITE_API_URL=http://localhost:8080
